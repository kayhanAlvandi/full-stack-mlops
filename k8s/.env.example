# Host paths for kind's extraMounts (k8s/kind-cluster.yaml).
# Copy this file to .env and set values for your local machine.
# DATA_PATH / MLFLOW_DATA_PATH are NOT set here -- k8s/Makefile derives them
# as "<repo>/data" / "<repo>/mlflow-data" automatically, so they're correct
# on every machine without editing.

# Access to the external tools library (label-backfill, register-benchmark)
TOOLS_LIB_PATH=/mnt/imdata/GITHUB/LIB_Python/tools

# Drive mount path (host path to O: drive), used by register-benchmark to
# read benchmark image files
O_DRIVE_PATH=/mnt/O
